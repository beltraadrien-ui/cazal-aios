# ============================================================
# AIOS Cazal Réfrigération — modèle de .env (PC de Loïc)
#
# MODE D'EMPLOI (jour de l'installation) :
#   1. Copier ce fichier et le renommer `.env` (à la racine du projet).
#   2. Remplacer chaque valeur REPLACE_WITH_... par la vraie clé,
#      directement dans l'éditeur — JAMAIS en la collant dans le chat Claude.
#   3. Vérifier : `python shared/config.py` → chaque ligne doit dire SET
#      (les 3 lignes Meta peuvent rester MISSING, voir plus bas).
#
# Le `.env` est gitignoré : il ne quitte jamais ce PC, et une mise à jour
# de l'AIOS (« maj ») ne l'écrase jamais.
# ============================================================

# --- Supabase : LA base de données du système (projet sur le compte de Loïc) ---
# Où trouver : supabase.com → ton projet → Settings ▸ API
SUPABASE_PROJECT_URL=REPLACE_WITH_YOUR_SUPABASE_PROJECT_URL
SUPABASE_ANON_KEY=REPLACE_WITH_YOUR_SUPABASE_ANON_KEY
# Access token du compte (optionnel — sert aux opérations d'administration ;
# où trouver : supabase.com → Account ▸ Access Tokens)
SUPABASE_ACCESS_TOKEN=REPLACE_WITH_YOUR_SUPABASE_ACCESS_TOKEN

# --- Apify : scrape Instagram (ton compte + concurrents) ---
# Où trouver : console.apify.com → Settings ▸ API & Integrations
APIFY_API_TOKEN=REPLACE_WITH_YOUR_APIFY_API_TOKEN

# --- OpenAI : transcription des reels (Whisper) + analyse des hooks (GPT) ---
# Où trouver : platform.openai.com → API keys
OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_API_KEY

# --- Meta Graph (OPTIONNEL — KPIs riches : reach, saves, shares, watch time) ---
# Tant que ces 3 lignes restent en REPLACE_WITH_..., le poller utilise Apify
# (métriques publiques) : le système marche quand même. Setup complet :
# MIGRATION-SUPABASE.md § JOUR J, bloc C-bis. ⚠️ Token longue durée ≈ 60 jours,
# à régénérer manuellement sur developers.facebook.com quand il expire.
META_ACCESS_TOKEN=REPLACE_WITH_YOUR_META_ACCESS_TOKEN
IG_USER_ID=REPLACE_WITH_YOUR_IG_USER_ID
IG_HANDLE=cazal_refrigeration
